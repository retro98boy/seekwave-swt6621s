#!/usr/bin/make -f

include /usr/share/dpkg/pkg-info.mk

%:
	dh $@ --with dkms

# The binary package contains sources, not modules built for the build host.
override_dh_auto_configure:
override_dh_auto_build:
override_dh_auto_test:
override_dh_auto_clean:

override_dh_auto_install:
	dh_install -X.nvbin Makefile drivers include usr/src/swt6621s-$(DEB_VERSION_UPSTREAM)

override_dh_dkms:
	dh_dkms -- dkms.conf

# Keep binary packages readable by older Debian and Ubuntu dpkg versions.
override_dh_builddeb:
	dh_builddeb -- -Zxz
